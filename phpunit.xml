<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE phpunit>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://schema.phpunit.de/9.5/phpunit.xsd"
    colors="true"
    backupGlobals="false"
    bootstrap="./tests/bootstrap.php"
    >
    <testsuites>
        <!-- Unit tests that don't need Application (fast) -->
        <testsuite name="unit">
            <file>tests/SpamGuardTest/SpamContextTest.php</file>
            <file>tests/SpamGuardTest/SpamResultTest.php</file>
            <file>tests/SpamGuardTest/SpamCheckerTest.php</file>
            <directory suffix="Test.php">tests/SpamGuardTest/SpamStrategy</directory>
            <directory suffix="Test.php">tests/SpamGuardTest/Stdlib</directory>
        </testsuite>
        <!-- Integration tests, with the database -->
        <testsuite name="integration">
            <file>tests/SpamGuardTest/SpamLogTest.php</file>
        </testsuite>
    </testsuites>
    <php>
        <env name="APPLICATION_ENV" value="testing"/>
        <includePath>./tests</includePath>
    </php>
</phpunit>
